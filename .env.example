# Copie ce fichier en .env et remplis les valeurs
# NE JAMAIS commit le fichier .env !

# Clé API SNCF (https://numerique.sncf.com/startup/api/)
SNCF_API_KEY=ta_cle_ici

# URL du webhook Discord (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optionnel : alertes par email (Phase 2). Pour Gmail, utilise un
# "mot de passe d'application" (pas ton mot de passe normal) :
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=ton_mot_de_passe_application
