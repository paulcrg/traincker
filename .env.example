# Copie ce fichier en .env et remplis les valeurs
# NE JAMAIS commit le fichier .env !

# Clé API SNCF (https://numerique.sncf.com/startup/api/)
SNCF_API_KEY=ta_cle_ici

# URL du webhook Discord (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optionnel : alertes par email (Phase 2). Pour Gmail, utilise un
# "mot de passe d'application" (pas ton mot de passe normal) :
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=ton_mot_de_passe_application

# Optionnel : base de données partagée Supabase (nécessaire uniquement pour
# l'hébergement en ligne sur Render, pour que le dashboard voie les données
# collectées par le cron GitHub Actions). Laisse vide pour du dev local
# (bascule automatique sur les fichiers CSV/JSON locaux).
SUPABASE_URL=
SUPABASE_KEY=
